<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <solid android:color="#A6120B0D" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#F0331E22" />
            <stroke
                android:width="1dp"
                android:color="#C49A6D55" />
            <padding
                android:left="5dp"
                android:top="5dp"
                android:right="5dp"
                android:bottom="5dp" />
        </shape>
    </item>
</layer-list>
