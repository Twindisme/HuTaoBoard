<?xml version="1.0" encoding="utf-8"?>
<!-- An inset lacquer-and-gold card that leaves the original Hu Tao toolbar visible around it. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#5CCD563C">
    <item
        android:left="2dp"
        android:top="6dp"
        android:right="2dp"
        android:bottom="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <gradient
                android:angle="270"
                android:startColor="#D94B2B2B"
                android:centerColor="#E13B2325"
                android:endColor="#ED2A191D" />
            <stroke
                android:width="1dp"
                android:color="#D8C29A6F" />
        </shape>
    </item>
</ripple>
